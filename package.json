{
  "name": "s7proxy",
  "version": "0.1.0",
  "description": "S7Comm proxy with AssemblyScript WASM protocol engine",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/lib.js"
    },
    "./worker": {
      "import": "./src/worker.js"
    }
  },
  "main": "./src/lib.js",
  "bin": {
    "s7proxy": "./src/index.js"
  },
  "files": [
    "src/",
    "build/s7engine.wasm",
    "config/default.yaml",
    "README.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:wasm": "asc assembly/index.ts --outFile build/s7engine.wasm --textFile build/s7engine.wat --optimize --sourceMap --exportRuntime --initialMemory 4",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "check-types": "tsc --project jsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@assemblyscript/loader": "^0.28.14",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.1",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.9.0",
    "eventemitter3": "^5.0.4",
    "fastify": "^5.8.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "ws": "^8.20.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "assemblyscript": "^0.28.14",
    "node-snap7": "^1.0.9",
    "vitest": "^4.1.4"
  }
}
