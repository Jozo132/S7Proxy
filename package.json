{
  "name": "s7proxy",
  "version": "0.4.1",
  "description": "S7Comm/S7CommPlus proxy with AssemblyScript WASM protocol engine",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/lib.js"
    },
    "./worker": {
      "import": "./src/worker.js"
    }
  },
  "main": "./src/lib.js",
  "bin": {
    "s7proxy": "src/index.js"
  },
  "files": [
    "src/",
    "public/",
    "build/s7engine.wasm",
    "config/default.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:wasm": "asc assembly/index.ts --outFile build/s7engine.wasm --textFile build/s7engine.wat --optimize --sourceMap --exportRuntime --initialMemory 4",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "check-types": "tsc --project jsconfig.json --noEmit",
    "explore:production": "node src/plus-explore.js --live"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@assemblyscript/loader": "^0.28.14",
    "@noble/hashes": "1.8.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "assemblyscript": "^0.28.14",
    "node-snap7": "^1.0.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
